        // 전역 메인 상태 객체
        let mapInstance = null;
        let activeInfoWindowOverlay = null;
        let activeMarkers = [];
        let userLocationMarker = null;
        let selectedCategoryFilter = 'ALL';
        let currentRenderedList = [...fossilDataset];

        // 기본 대한민국 중심 좌표 (백업용: 세종특별자치시 부근)
        const DEFAULT_FALLBACK_CENTER = { lat: 36.4800, lng: 127.2890 };
        const DEFAULT_ZOOM_LEVEL = 5; // 요구조건 zoom level 5

        /**
         * kakao.maps.load 콜백으로 카카오 지도 객체가 완벽하게 로드된 후 시작
         */
        window.addEventListener('load', () => {
            if (typeof kakao !== 'undefined' && kakao.maps) {
                kakao.maps.load(() => {
                    initFossilMapApp();
                });
            } else {
                alert('카카오 지도 API 로드에 실패했습니다. API 키 및 인터넷 연결을 확인해 주세요.');
            }
        });

        /**
         * 애플리케이션 초기화 구동
         */
        function initFossilMapApp() {
            const mapContainer = document.getElementById('map');
            const mapOptions = {
                center: new kakao.maps.LatLng(DEFAULT_FALLBACK_CENTER.lat, DEFAULT_FALLBACK_CENTER.lng),
                level: DEFAULT_ZOOM_LEVEL
            };

            // 1. 카카오 지도 객체 생성
            mapInstance = new kakao.maps.Map(mapContainer, mapOptions);

            // 2. 지도 컨트롤러 추가
            const zoomControl = new kakao.maps.ZoomControl();
            mapInstance.addControl(zoomControl, kakao.maps.ControlPosition.RIGHT);

            // 3. Geolocation 현재 위치 감지 및 이동
            fetchUserCurrentLocation();

            // 4. 초기 유적지 데이터 마커 및 사이드바 렌더링
            renderFossilData();

            // 5. 이벤트 등록
            attachEventListeners();

            // 6. 로더 비활성화
            const loader = document.getElementById('mapLoader');
            if (loader) {
                loader.classList.add('opacity-0');
                setTimeout(() => loader.style.display = 'none', 300);
            }
        }

        /**
         * 사용자 현재 위치를 요청하여 지도 중심으로 이동 및 커스텀 마커 표시
         */
        function fetchUserCurrentLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const userLat = position.coords.latitude;
                        const userLng = position.coords.longitude;
                        const userLatLng = new kakao.maps.LatLng(userLat, userLng);

                        // 지도 중심으로 부드럽게 이동
                        mapInstance.setCenter(userLatLng);
                        mapInstance.setLevel(DEFAULT_ZOOM_LEVEL);

                        // 기존 위치 마커 제거
                        if (userLocationMarker) userLocationMarker.setMap(null);

                        // 사용자 현위치 커스텀 펄스 오버레이 마커
                        const userMarkerElement = document.createElement('div');
                        userMarkerElement.className = 'user-pulse-marker flex items-center justify-center';
                        userMarkerElement.innerHTML = `<div class="w-3.5 h-3.5 bg-sky-600 border-2 border-white rounded-full shadow-md z-10"></div>`;

                        userLocationMarker = new kakao.maps.CustomOverlay({
                            position: userLatLng,
                            content: userMarkerElement,
                            yAnchor: 0.5,
                            xAnchor: 0.5
                        });

                        userLocationMarker.setMap(mapInstance);
                    },
                    (error) => {
                        console.warn("Geolocation 권한 거부 또는 오류:", error.message);
                        // 위치 권한 거부시 기본 중심 좌표 사용
                        mapInstance.setCenter(new kakao.maps.LatLng(DEFAULT_FALLBACK_CENTER.lat, DEFAULT_FALLBACK_CENTER.lng));
                    },
                    { enableHighAccuracy: true, timeout: 7000, maximumAge: 0 }
                );
            }
        }

        /**
         * 마커 및 사이드바 리스트 갱신
         */
        function renderFossilData() {
            // 기존 마커 및 오버레이 초기화
            clearAllMarkers();
            if (activeInfoWindowOverlay) {
                activeInfoWindowOverlay.setMap(null);
                activeInfoWindowOverlay = null;
            }

            const listContainer = document.getElementById('fossilList');
            const countDisplay = document.getElementById('resultCount');
            listContainer.innerHTML = '';
            countDisplay.innerText = currentRenderedList.length;

            if (currentRenderedList.length === 0) {
                listContainer.innerHTML = `
                    <div class="text-center py-12 text-slate-400">
                        <i class="fa-solid fa-magnifying-glass-location text-3xl mb-3 text-slate-300"></i>
                        <p class="text-sm font-medium">검색어와 일치하는 화석 유적지가 없습니다.</p>
                    </div>
                `;
                return;
            }

            // 필터링된 데이터 반복 루프
            currentRenderedList.forEach((site) => {
                const siteLatLng = new kakao.maps.LatLng(site.lat, site.lng);

                // 카카오 지도 마커 생성
                const marker = new kakao.maps.Marker({
                    position: siteLatLng,
                    title: site.name
                });
                marker.setMap(mapInstance);
                activeMarkers.push(marker);

                // 마커 클릭 시 해당 유적지 포커싱
                kakao.maps.event.addListener(marker, 'click', () => {
                    handleSelectFossilSite(site, marker);
                });

                // 사이드바 리스트 카드 엘리먼트 생성
                const card = document.createElement('div');
                card.className = 'site-card bg-white p-3.5 rounded-xl border border-slate-200 hover:border-geo-600 hover:shadow-md transition-all duration-200 cursor-pointer group relative';
                card.dataset.id = site.id;

                card.innerHTML = `
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[10px] font-bold text-geo-800 bg-geo-50 border border-geo-600/20 px-2 py-0.5 rounded-md">
                            ${site.designation}
                        </span>
                        <span class="text-[11px] text-amber-700 font-medium">${site.categoryName}</span>
                    </div>
                    <h3 class="font-bold text-sm text-slate-800 group-hover:text-geo-700 transition-colors leading-snug">${site.name}</h3>
                    <p class="text-xs text-slate-500 mt-1 line-clamp-1"><i class="fa-solid fa-location-dot text-slate-400 mr-1"></i>${site.address}</p>
                `;

                // 사이드바 카드를 누르면 이동 및 팝업
                card.addEventListener('click', () => {
                    handleSelectFossilSite(site, marker);
                });

                listContainer.appendChild(card);
            });
        }

        /**
         * 특정 유적지 선택 처리 (panTo 이동, CustomOverlay 인포윈도우 표시)
         */
        function handleSelectFossilSite(site, marker) {
            const targetLatLng = new kakao.maps.LatLng(site.lat, site.lng);

            // 1. 지도 시점 부드럽게 이동
            mapInstance.panTo(targetLatLng);

            // 2. 열려있는 기존 오버레이 닫기
            if (activeInfoWindowOverlay) {
                activeInfoWindowOverlay.setMap(null);
            }

            // 3. 커스텀 인포윈도우 DOM 엘리먼트 동적 생성
            const overlayNode = document.createElement('div');
            overlayNode.className = 'info-card-overlay bg-white rounded-2xl shadow-2xl border border-slate-200 p-4.5 w-72 md:w-80 transition-all';
            
            overlayNode.innerHTML = `
                <div class="flex items-start justify-between mb-2">
                    <span class="text-[10px] font-bold text-geo-800 bg-geo-50 border border-geo-600/20 px-2 py-0.5 rounded-md">
                        ${site.designation}
                    </span>
                    <button class="close-overlay-btn text-slate-400 hover:text-slate-600 p-1 -mr-1 -mt-1">
                        <i class="fa-solid fa-xmark text-base"></i>
                    </button>
                </div>
                <h4 class="font-bold text-base text-slate-900 leading-snug mb-1.5">${site.name}</h4>
                <p class="text-xs text-slate-500 mb-2 flex items-center">
                    <i class="fa-solid fa-map-pin text-rose-500 mr-1.5 shrink-0"></i>${site.address}
                </p>
                <p class="text-xs text-slate-600 bg-slate-50 p-2.5 rounded-xl border border-slate-100 leading-relaxed mb-3">
                    ${site.description}
                </p>
                <div class="flex justify-end">
                    <a href="https://map.kakao.com/link/map/${encodeURIComponent(site.name)},${site.lat},${site.lng}" 
                       target="_blank" 
                       class="inline-flex items-center space-x-1.5 text-xs bg-geo-700 hover:bg-geo-800 text-white font-medium px-3 py-1.5 rounded-lg shadow-sm transition-colors">
                        <span>카카오맵 길찾기</span>
                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                    </a>
                </div>
            `;

            // 인포윈도우 닫기 이벤트
            overlayNode.querySelector('.close-overlay-btn').addEventListener('click', () => {
                if (activeInfoWindowOverlay) {
                    activeInfoWindowOverlay.setMap(null);
                    activeInfoWindowOverlay = null;
                }
            });

            // 오버레이 등록
            activeInfoWindowOverlay = new kakao.maps.CustomOverlay({
                content: overlayNode,
                map: mapInstance,
                position: marker.getPosition(),
                yAnchor: 1.22,
                xAnchor: 0.5
            });

            // 4. 사이드바 항목 활성화 하이라이트
            highlightActiveCard(site.id);
        }

        /**
         * 사이드바 내 지정된 ID 카드에 액티브 클래스 부여
         */
        function highlightActiveCard(siteId) {
            document.querySelectorAll('.site-card').forEach(card => {
                if (parseInt(card.dataset.id) === siteId) {
                    card.classList.add('border-geo-600', 'bg-geo-50/40', 'ring-2', 'ring-geo-600/20');
                    card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } else {
                    card.classList.remove('border-geo-600', 'bg-geo-50/40', 'ring-2', 'ring-geo-600/20');
                }
            });
        }

        /**
         * 활성화된 기존 마커 전체 삭제
         */
        function clearAllMarkers() {
            activeMarkers.forEach(m => m.setMap(null));
            activeMarkers = [];
        }

        /**
         * 실시간 검색 및 카테고리 필터링 적용
         */
        function executeSearchAndFilter() {
            const searchKeyword = document.getElementById('searchInput').value.trim().toLowerCase();
            const btnClear = document.getElementById('btnClearSearch');

            if (searchKeyword.length > 0) {
                btnClear.classList.remove('hidden');
            } else {
                btnClear.classList.add('hidden');
            }

            currentRenderedList = fossilDataset.filter(item => {
                // 카테고리 매칭
                const categoryMatch = (selectedCategoryFilter === 'ALL') || (item.category === selectedCategoryFilter);
                
                // 키워드 매칭 (유적지 이름, 주소, 설명 검색 지원)
                const keywordMatch = !searchKeyword || 
                    item.name.toLowerCase().includes(searchKeyword) || 
                    item.address.toLowerCase().includes(searchKeyword) || 
                    item.description.toLowerCase().includes(searchKeyword);

                return categoryMatch && keywordMatch;
            });

            renderFossilData();
        }

        /**
         * 이벤트 리스너 통합 연결
         */
        function attachEventListeners() {
            const searchInput = document.getElementById('searchInput');
            const btnClear = document.getElementById('btnClearSearch');
            const filterBtns = document.querySelectorAll('.filter-btn');

            // 실시간 키워드 검색
            searchInput.addEventListener('input', executeSearchAndFilter);

            // 검색어 리셋 버튼
            btnClear.addEventListener('click', () => {
                searchInput.value = '';
                executeSearchAndFilter();
                searchInput.focus();
            });

            // 내 위치 이동 버튼 클릭
            document.getElementById('btnMyLocation').addEventListener('click', () => {
                fetchUserCurrentLocation();
            });

            // 카테고리 필터 버튼 그룹 클릭
            filterBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    filterBtns.forEach(b => {
                        b.classList.remove('bg-geo-800', 'text-white', 'shadow-sm');
                        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
                    });

                    e.currentTarget.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
                    e.currentTarget.classList.add('bg-geo-800', 'text-white', 'shadow-sm');

                    selectedCategoryFilter = e.currentTarget.dataset.category;
                    executeSearchAndFilter();
                });
            });
        }
    </script>
</body>
</html>
